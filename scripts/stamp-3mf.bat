@echo off
REM ============================================================================
REM  מספר הזמנה על קובץ הדפסה.
REM
REM  גוררים קובץ 3MF ששמו UNIT3D-12345.3mf אל הקובץ הזה, וזהו. מה שהמדפסת
REM  מציגה כשם ההדפסה הוא "Title" שבתוך הקובץ (שם הדגם של המעצב), לא שם
REM  הקובץ ולא שם הפלטה. זה מחליף אותו במספר ההזמנה.
REM
REM  אחרי זה פותחים את הקובץ בבמבו סטודיו ושולחים כרגיל.
REM ============================================================================
setlocal
chcp 65001 >nul
cd /d "%~dp0.."
if "%~1"=="" (
  echo.
  echo   גרור קובץ 3MF על הקובץ הזה.
  echo.
  pause
  exit /b 1
)
call npm run --silent stamp:3mf -- "%~1" %2
echo.
pause
