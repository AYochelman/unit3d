@echo off
REM ============================================================================
REM  התחברות חד-פעמית למייקרוורלד.
REM
REM  מקליקים פעמיים על הקובץ הזה. נפתח דפדפן, מתחברים כרגיל, וזהו.
REM
REM  מה שקורה כאן: הדפדפן נפתח עם תיקיית פרופיל משלו (data\mw-profile), ולכן
REM  ההתחברות נשמרת שם ולא נעלמת. הסנכרון היומי משתמש באותו פרופיל, כך שהוא
REM  תמיד מחובר - בלי טוקן להדביק ובלי משהו שפג ודורש חידוש.
REM
REM  אפשר להריץ אותו שוב מתי שרוצים; אם ההתחברות תפוג יום אחד, זו הריצה
REM  שמחזירה אותה.
REM ============================================================================
setlocal
cd /d "%~dp0.."

set MAKERWORLD_PROFILE_DIR=%~dp0..\data\mw-profile

echo.
echo   נפתח כרום רגיל. תתחבר למייקרוורלד, תסגור את חלון הדפדפן,
echo   ורק אז תחזור לחלון הזה ותלחץ Enter.
echo.

call npm run sync:collections -- --login

echo.
echo   סיימנו. מכאן הסנכרון היומי כבר מחובר.
echo.
pause
endlocal
