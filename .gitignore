# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# Project-specific
/handoff/

/.next-old/
/_recovered-newest/
*.zip
/out/

# local verification scripts / screenshots (never shipped)
/*.cjs
/m-*.png
/m2-*.png
/c-*.png
/d-*.png
/shot-*.png
/p-*.png
/n-*.png

# the agent holds the printer access code and a service key
agent/config.json
agent/node_modules/
agent/.tmp.mp4
# Which timelapses this machine has already dealt with — per-machine, not shared.
agent/timelapse-state.json

# The signed-in MakerWorld browser profile. Never leaves his machine.
data/mw-profile/
scripts/sync-daily.log

# The Supabase service key on the owner PC, for the one-off folder import.
agent/supabase-key.txt

# Impeccable (npx impeccable install). The skills, agents and launcher are
# tracked; these are per-machine or per-run and are not.
# Engine binaries are fetched per platform by the launcher on first run.
**/skills/impeccable/scripts/bin/
# Claude Code hook registration is machine-local by design (hooks.md).
.claude/settings.local.json
# Hook cache / local config / per-run critique snapshots.
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
.impeccable/config.local.json
.impeccable/history/
.impeccable/critique/*
!.impeccable/critique/ignore.md

# Which sweep this machine already folded in — per-machine, not shared.
data/collected-state.json
